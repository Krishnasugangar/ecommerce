# Copy values into OS/IDE environment variables or a gitignored application-local.yml.
# Do not commit real secrets.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USERNAME=root
DB_PASSWORD=change-me

# Server
SERVER_PORT=8080

# Hibernate schema handling for local development (update | validate | none)
JPA_DDL_AUTO=update

# JWT — use a long random value in any shared/deployed environment
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap admin (created on first startup if missing)
APP_ADMIN_EMAIL=admin@ecommerce.local
APP_ADMIN_PASSWORD=Admin@12345

# Demo catalog seed
APP_SEED_SAMPLE_DATA=true

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api
