# Copy this file to .env and fill in local values.
# Spring Boot does not load .env automatically.
# Set these as OS/IDE environment variables, or create
# backend/src/main/resources/application-local.yml (gitignored).

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USERNAME=root
DB_PASSWORD=change-me

# Server
SERVER_PORT=8080

# Hibernate schema handling for local development (update | validate | none)
JPA_DDL_AUTO=update
